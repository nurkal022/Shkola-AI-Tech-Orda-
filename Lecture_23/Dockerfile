# ============================================================
# Лекция 23: Dockerfile для AI Chat API
# ============================================================
#
# Этот Dockerfile создаёт контейнер для FastAPI-приложения.
# Использует multi-stage build для минимального размера образа.
#
# Сборка:   docker build -t ai-chat-api .
# Запуск:   docker run -p 8000:8000 -e OPENAI_API_KEY=sk-... ai-chat-api
# ============================================================

# ─────────────────────────────────────────────
# Stage 1: Базовый образ Python
# ─────────────────────────────────────────────
FROM python:3.12-slim

# Метаданные
LABEL maintainer="TechOrda"
LABEL description="AI Chat API — FastAPI + OpenAI"
LABEL version="1.0.0"

# ─────────────────────────────────────────────
# Переменные окружения
# ─────────────────────────────────────────────

# Не создавать .pyc файлы
ENV PYTHONDONTWRITEBYTECODE=1
# Не буферизовать stdout/stderr (видим логи сразу)
ENV PYTHONUNBUFFERED=1
# Порт (можно переопределить при запуске)
ENV PORT=8000

# ─────────────────────────────────────────────
# Рабочая директория
# ─────────────────────────────────────────────
WORKDIR /app

# ─────────────────────────────────────────────
# Зависимости (кешируются отдельно от кода!)
# ─────────────────────────────────────────────

# Копируем ТОЛЬКО requirements.txt сначала.
# Если зависимости не изменились — Docker использует кеш.
COPY app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ─────────────────────────────────────────────
# Код приложения
# ─────────────────────────────────────────────
COPY app/main.py .

# ─────────────────────────────────────────────
# Порт и запуск
# ─────────────────────────────────────────────

# Документируем порт (фактически открывает -p при docker run)
EXPOSE ${PORT}

# Healthcheck — Docker/Kubernetes проверяет что приложение живо
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT}/health')" || exit 1

# Запускаем uvicorn
# --host 0.0.0.0 — слушаем на всех интерфейсах (обязательно в Docker!)
# --workers 1 — для простоты; в продакшене 2-4
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT}
